// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Era {
  id             String          @id @default(uuid())
  title          String
  description    String?
  startYear      String 
  endYear        String
  imageUrl       String?
  isPublished     Boolean         @default(true)
  position        Int
  stories         Story[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Story {
  id          String   @id @default(uuid())
  eraId       String

  title       String
  description String?
  scientistNames String[]

  imageUrl    String?

  position    Int

  isPopular   Boolean  @default(false)
  isPublished   Boolean  @default(false)

  discipline  String?
  subject     String?
  geolocation String?

  estimatedReadTime String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks StoryBlock[]
  quizzes Quiz[]

  era         Era  @relation(fields: [eraId], references: [id],onDelete: Cascade)
  storyProgresses StoryProgress[]
}


model StoryBlock {
  id        String      @id @default(uuid())
  storyId   String
  type      ContentType
  label     String?
  content   Json?
  position  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sentences StoryBlockSentence[]
}

model StoryBlockSentence {
  id           String   @id @default(uuid())
  storyBlockId String
  text         String
  textHash     String
  position     Int

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storyBlock   StoryBlock    @relation(fields: [storyBlockId],references: [id],onDelete: Cascade)

  audioVariants SentenceAudio[]

  @@index([storyBlockId, position])
  @@index([storyBlockId, textHash])
}

model SentenceAudio {
  id            String   @id @default(uuid())
  sentenceId    String
  languageCode  String
  voiceName     String

  status        AudioGenerationStatus @default(PENDING)

  audioUrl      String?
  storagePath   String?
  durationMs    Int?
  errorMessage  String?
  attemptCount  Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sentence      StoryBlockSentence @relation(fields: [sentenceId],references: [id],onDelete: Cascade)

  @@unique([sentenceId, languageCode, voiceName])
  @@index([status])
}

enum AudioGenerationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ContentType {
  PARAGRAPH
  IMAGE
  LINK
  HIGHLIGHT
  QUOTATION
  CARD
  RELATED_CONTENT
  SCIENTIST_CARD
}

model Quiz {
  id         String   @id @default(uuid())
  storyId     String
  title       String
  timeLimit   Int?
  marksPerQuestion Int @default(5)

  questions    Question[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  story       Story   @relation(fields: [storyId], references: [id],onDelete: Cascade)

  quizAttempts QuizAttempt[]
}

model Question {
  id         String   @id @default(uuid())  
  quizId      String
  questionText String
  explanation String?
  category  String[]
  difficulty  DifficultyLevel @default(EASY)
  position Int
  options     Option[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quiz        Quiz    @relation(fields: [quizId], references: [id],onDelete: Cascade)

  questionAttempts QuestionAttempt[]
}
enum DifficultyLevel {
  EASY
  MODERATE
  ADVANCED
}


model Option {
  id         String   @id @default(uuid())
  questionId  String
  optionText String
  position Int
  isCorrect   Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  question    Question @relation(fields: [questionId], references: [id],onDelete: Cascade)

  questionAttempts QuestionAttempt[]
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique

  googleId String? @unique
  profileImage   String?
  password       String?
  grade          String?
  age            Int?

  // Email verification
  isVerified     Boolean  @default(false)

  // Session management
  sessionVersion Int      @default(0)

  // Authorization
  role           UserRole @default(STUDENT)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  storyProgresses StoryProgress[]
  quizAttempts    QuizAttempt[]

  sessions Session[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique

  sessionVersion   Int
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
model EmailOTP {
  id        String    @id @default(uuid())
  email     String
  otp       String
  purpose   OTPPurpose
  name      String?
  age       Int?
  attempts  Int       @default(0)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

enum OTPPurpose {
  REGISTER
  RESET_PASSWORD
}

enum UserRole {
  STUDENT
  PREMIUM_STUDENT
  ADMIN
  EDITOR
}

model StoryProgress {
  id String @id @default(uuid())

  userId String
  storyId String

  blocksRead Int @default(0)
  

  storyCompleted Boolean @default(false)
  quizCompleted Boolean @default(false)

  startedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  story Story @relation(fields:[storyId], references:[id], onDelete:Cascade)

  @@unique([userId, storyId])
}


enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model QuizAttempt {
  id String @id @default(uuid())

  userId String
  quizId String

  score Int @default(0)

  totalQuestions Int

  accuracy Float @default(0)

  timeTaken Int? // seconds

  status QuizAttemptStatus @default(IN_PROGRESS)

  startedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionAttempts QuestionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionAttempt {
  id String @id @default(uuid())

  quizAttemptId String

  questionId String

  selectedOptionId String

  isCorrect Boolean

  attemptedAt DateTime @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId],references: [id],onDelete: Cascade)

  question Question @relation( fields: [questionId],references: [id],onDelete: Cascade)

  option Option @relation(fields: [selectedOptionId],references: [id])

  @@unique([quizAttemptId, questionId])
}

model UploadedImage {
  id        String   @id @default(uuid())
  sha256    String   @unique
  filename  String   @unique
  imageUrl  String
  sizeBytes Int
  createdAt DateTime @default(now())
}