// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Era {
  id             String          @id @default(uuid())
  title          String
  description    String?
  startYear      String 
  endYear        String
  imageUrl       String?
  isPublished     Boolean         @default(true)
  position        Int
  stories         Story[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Story {
  id          String   @id @default(uuid())
  eraId       String

  title       String
  description String?
  scientistNames String[]

  imageUrl    String?

  position    Int

  isPopular   Boolean  @default(false)
  isPublished   Boolean  @default(false)

  discipline  String?
  subject     String?
  geolocation String?

  estimatedReadTime String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks StoryBlock[]
  quizzes Quiz[]

  era         Era  @relation(fields: [eraId], references: [id],onDelete: Cascade)
  storyProgresses StoryProgress[]
}


model StoryBlock {
  id         String   @id @default(uuid())
  storyId     String
  type ContentType
  label     String? 
  content Json?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story   @relation(fields: [storyId], references: [id],onDelete: Cascade)
}

enum ContentType {
  PARAGRAPH
  IMAGE
  LINK
  HIGHLIGHT
  QUOTATION
  CARD
  RELATED_CONTENT
  SCIENTIST_CARD
}

model Quiz {
  id         String   @id @default(uuid())
  storyId     String
  title       String
  timeLimit   Int?
  marksPerQuestion Int @default(5)

  questions    Question[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  story       Story   @relation(fields: [storyId], references: [id],onDelete: Cascade)

  quizAttempts QuizAttempt[]
}

model Question {
  id         String   @id @default(uuid())  
  quizId      String
  questionText String
  explanation String?
  category  String[]
  difficulty  DifficultyLevel @default(EASY)
  position Int
  options     Option[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quiz        Quiz    @relation(fields: [quizId], references: [id],onDelete: Cascade)

  questionAttempts QuestionAttempt[]
}
enum DifficultyLevel {
  EASY
  MODERATE
  ADVANCED
}


model Option {
  id         String   @id @default(uuid())
  questionId  String
  optionText String
  position Int
  isCorrect   Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  question    Question @relation(fields: [questionId], references: [id],onDelete: Cascade)

  questionAttempts QuestionAttempt[]
}

model User {
  id           String    @id @default(uuid())

  name         String
  email        String    @unique
  profileImage String?
  password     String?

  grade String?

   // Email Verification
  isVerified      Boolean   @default(false)

  // Authorization
  role         UserRole  @default(STUDENT)
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  

  storyProgresses StoryProgress[]

  quizAttempts QuizAttempt[]
}

model EmailOTP {
  id         String   @id @default(uuid())

  email      String
  otp        String

  expiresAt  DateTime

  createdAt  DateTime @default(now())
}

enum UserRole {
  STUDENT
  PREMIUM_STUDENT
  ADMIN
  EDITOR
}

model StoryProgress {
  id String @id @default(uuid())

  userId String
  storyId String

  blocksRead Int @default(0)
  

  storyCompleted Boolean @default(false)
  quizCompleted Boolean @default(false)

  startedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  story Story @relation(fields:[storyId], references:[id], onDelete:Cascade)

  @@unique([userId, storyId])
}


enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model QuizAttempt {
  id String @id @default(uuid())

  userId String
  quizId String

  score Int @default(0)

  totalQuestions Int

  accuracy Float @default(0)

  timeTaken Int? // seconds

  status QuizAttemptStatus @default(IN_PROGRESS)

  startedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionAttempts QuestionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionAttempt {
  id String @id @default(uuid())

  quizAttemptId String

  questionId String

  selectedOptionId String

  isCorrect Boolean

  attemptedAt DateTime @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId],references: [id],onDelete: Cascade)

  question Question @relation( fields: [questionId],references: [id],onDelete: Cascade)

  option Option @relation(fields: [selectedOptionId],references: [id])

  @@unique([quizAttemptId, questionId])
}